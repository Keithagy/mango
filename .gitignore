target/
**/node_modules/

# Example-local runtime config and state.
# Keep checked-in templates (`*.example.toml`) and manifests (`Cargo.toml`);
# ignore per-developer configs, env files, and runtime state.
examples/*/*.toml
!examples/*/Cargo.toml
!examples/*/*.example.toml
examples/*/*.env
examples/*/.env
examples/*/.env.*
examples/*/*-state.json
examples/*/*.session
examples/*/*.session-*
